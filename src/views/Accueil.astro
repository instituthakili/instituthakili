---
import Base from '../layouts/Base.astro';
import Anneaux from '../components/Anneaux.astro';
import Portrait from '../components/Portrait.astro';
import CarrouselIndices from '../components/CarrouselIndices.astro';
import Logo from '../components/Logo.astro';
import Icone from '../components/Icone.astro';
import LignePublication from '../components/LignePublication.astro';
import { UI, route } from '../lib/i18n.js';
import { contenus, url, tr } from '../lib/content.js';
import { extrait } from '../lib/format.js';

interface Props { lang: 'fr' | 'en'; cle: string; slug?: string }
const { lang, cle } = Astro.props;
const t = UI[lang];
const c = await contenus();
const page = c.pages.accueil;
const bienvenue = c.pages.bienvenue;
const directeur = c.equipe.find((m) => m.data.groupe === 'direction');
const misesEnAvant = c.publications.filter((p) => p.data.en_avant);
const publications = [...misesEnAvant, ...c.publications.filter((p) => !p.data.en_avant)].slice(0, 5);
const alterne = url(route(cle, lang === 'fr' ? 'en' : 'fr'));
const titreBienvenue = tr(bienvenue, 'titre', lang) || t.motBienvenue;
---
<Base lang={lang} cle={cle} alterne={alterne} description={tr(page, 'texte', lang) ? extrait(tr(page, 'texte', lang), 160) : undefined}>
  <section class="ouverture" aria-labelledby="titre-accueil">
    <div class="ouverture__fond" aria-hidden="true">
      <span class="ouverture__halo ouverture__halo--vert"></span>
      <span class="ouverture__halo ouverture__halo--terre"></span>
    </div>
    <div class="conteneur">
      <h1 class="visuellement-cache" id="titre-accueil">{tr(c.reglages, 'nom_complet', lang)}</h1>
      <div class="ouverture__grille">
        {directeur && (
          <div class="ouverture__directeur">
            <Portrait personne={directeur} lang={lang} chargement="eager" class="ouverture__portrait" />
            <p class="ouverture__nom">{directeur.data.nom}</p>
            <span class="ouverture__filet" aria-hidden="true"></span>
            <p class="ouverture__fonction">{tr(directeur.data, 'fonction', lang)}</p>
            <a class="bouton bouton--plein bouton--arrondi ouverture__bouton" href={url(route('bienvenue', lang))}>
              {titreBienvenue}<Icone nom="fleche-droite" />
            </a>
          </div>
        )}
        <div class="ouverture__visuel" aria-hidden="true">
          <Anneaux />
        </div>
      </div>
    </div>
  </section>

  {c.indices.length > 0 && (
    <CarrouselIndices indices={c.indices} lang={lang} titre={tr(page, 'indices_titre', lang)} texte={tr(page, 'indices_texte', lang)} />
  )}

  {publications.length > 0 && (
    <section class="section">
      <div class="conteneur">
        <div class="tete-section">
          <div class="tete-section__texte">
            <p class="surtitre">{t.introRegistre}</p>
            <h2>{t.publicationsRecentes}</h2>
          </div>
          <a class="lien-fleche" href={url(route('publications', lang))}>{t.toutesPublications}<Icone nom="fleche-droite" /></a>
        </div>
        <ul class="registre">
          {publications.map((p) => <LignePublication p={p} lang={lang} />)}
        </ul>
      </div>
    </section>
  )}

  <section class="section section--serree">
    <div class="conteneur">
      <div class="appel">
        <div>
          <h2>{tr(page, 'appel_titre', lang)}</h2>
          <p>{tr(page, 'appel_texte', lang)}</p>
        </div>
        <a class="bouton bouton--clair" href={url(route('contact', lang))}>{t.ecrire}<Icone nom="fleche-droite" /></a>
        <div class="appel__motif" aria-hidden="true"><Logo symboleSeul /></div>
      </div>
    </div>
  </section>
</Base>
