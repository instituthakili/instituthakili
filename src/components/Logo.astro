---
/* Logo de l'Institut HAKILI, piste « Le Cercle de palabre ».
   Le logotype est vectorisé (TeX Gyre Adventor), il ne dépend d'aucune police installée.
   Les couleurs suivent les variables CSS du conteneur (--logo-anneau, --logo-accent, --logo-texte, --logo-texte-2). */
interface Props { titre?: string; class?: string; symboleSeul?: boolean }
const { titre = 'Institut HAKILI', class: cls = '', symboleSeul = false } = Astro.props;
---
{symboleSeul ? (
  <svg class={`logo logo--symbole ${cls}`} viewBox="0 0 200 200" role="img" aria-label={titre} focusable="false">
    <g class="logo__anneaux">
      <circle class="logo__a1" cx="100" cy="100" r="82" fill="none" stroke-width="13" stroke-linecap="round" stroke-dasharray="403.59 111.63" transform="rotate(51 100 100)" />
      <circle class="logo__a2" cx="100" cy="100" r="56" fill="none" stroke-width="13" stroke-linecap="round" stroke-dasharray="281.49 70.37" transform="rotate(171 100 100)" />
      <circle class="logo__a3" cx="100" cy="100" r="30" fill="none" stroke-width="13" stroke-linecap="round" stroke-dasharray="153.94 34.56" transform="rotate(291 100 100)" />
      <circle class="logo__point" cx="100" cy="100" r="9" />
    </g>
  </svg>
) : (
  <svg class={`logo ${cls}`} viewBox="0 0 328 112" role="img" aria-label={titre} focusable="false">
    <g transform="translate(0 10) scale(0.46)">
