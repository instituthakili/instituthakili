---
// Grand motif du Cercle de palabre, animé à l'ouverture de la page d'accueil.
// La couronne de cent graduations rappelle la notation des indices HAKILI sur 100 points.
const graduations = Array.from({ length: 100 }, (_, i) => {
  const angle = (i / 100) * Math.PI * 2 - Math.PI / 2;
  const longue = i % 10 === 0;
  const r1 = longue ? 90.5 : 93;
  const r2 = 97;
  const f = (n: number) => Math.round(n * 1000) / 1000;
  return {
    x1: f(100 + r1 * Math.cos(angle)),
    y1: f(100 + r1 * Math.sin(angle)),
    x2: f(100 + r2 * Math.cos(angle)),
    y2: f(100 + r2 * Math.sin(angle)),
    longue,
  };
});
const anneaux = [
  { cls: 'r1', r: 82, arc: 403.59, rot: 51 },
  { cls: 'r2', r: 56, arc: 281.49, rot: 171 },
  { cls: 'r3', r: 30, arc: 153.94, rot: 291 },
];
---
<svg class="anneaux" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  <g class="anneaux__graduations">
    {graduations.map((g) => (
      <line x1={g.x1} y1={g.y1} x2={g.x2} y2={g.y2} class={g.longue ? 'longue' : ''} />
    ))}
  </g>
  <g class="anneaux__guides">
    <circle cx="100" cy="100" r="82" />
    <circle cx="100" cy="100" r="56" />
    <circle cx="100" cy="100" r="30" />
  </g>
  {anneaux.map((a) => {
    const c = 2 * Math.PI * a.r;
    return (
      <g class={a.cls}>
        <circle
          class="trace"
          cx="100"
          cy="100"
          r={a.r}
          fill="none"
          stroke-width="13"
          stroke-linecap="round"
          stroke-dasharray={`${a.arc} ${c.toFixed(2)}`}
          transform={`rotate(${a.rot} 100 100)`}
          style={`--longueur:${a.arc}`}
        />
      </g>
    );
  })}
  <circle class="anneaux__point" cx="100" cy="100" r="9" />
</svg>
